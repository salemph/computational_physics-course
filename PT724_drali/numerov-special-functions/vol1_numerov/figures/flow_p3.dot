digraph G {
  graph [fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
  s [label="START", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  a [label="Input: L, N, E_max;  x_i = −L + i h,  V = x²/2"];
  b [label="Scan E = E_min … E_max with step ΔE"];
  c [label="SHOOT(E):\n• m = node at turning point √(2E)\n• outward Numerov  −L → x_{m+1}  (ψ_0=0, ψ_1=ε)\n• inward  Numerov  +L → x_{m−1}  (ψ_N=0, ψ_{N−1}=ε)\n• D(E) = ψL_{m+1}ψR_m − ψL_mψR_{m+1}"];
  d [label="sign D changed ?", shape=diamond, fillcolor="#fff4dc", color="#eda100"];
  e [label="Bisection on D(E) until |b−a| < tol"];
  f [label="Glue: ψ = ψL (x ≤ x_m), ψR·ψL_m/ψR_m (x > x_m)"];
  g [label="Normalise (Simpson); count nodes → label n"];
  h [label="Verify: E_n vs n+½, ψ vs Hermite functions,\northogonality, virial ⟨V⟩ = E/2"];
  k [label="E < E_max ?", shape=diamond, fillcolor="#fff4dc", color="#eda100"];
  j [label="Error analysis: E_n vs h (order 4), vs L (box),\nround-off floor, Richardson"];
  t [label="END: plots + tables", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  s->a->b->c->d; d->e [label="yes"]; d->k [label="no"]; e->f->g->h->k; k->b [label="yes, E+ΔE"]; k->j [label="no"]; j->t;
}
