digraph G {
  graph [fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
  s [label="START", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  a [label="Input: V0, a, E, h, padding\nk = √(2E); grid with nodes on x=0 and x=a"];
  b [label="V on grid; edge nodes: V = V0/2\nk²_i = 2(E − V_i), c_i"];
  c [label="Right boundary (transmitted wave, F=1):\nψ_N = e^{ikx_N},  ψ_{N−1} = e^{ikx_{N−1}}"];
  d [label="j = N − 1, N − 2, …, 1  (backward)"];
  e [label="node j at an edge ?", shape=diamond, fillcolor="#fff4dc", color="#eda100"];
  e1 [label="add jump term\nδ = −(h³/12)[k²] ψ'(x_j)\nψ' from one-sided formula"];
  e2 [label="neighbour of an edge?\nuse ONE-SIDED V in c_{j±1}"];
  f [label="ψ_{j−1} = [(12−10c_j)ψ_j − c_{j+1}ψ_{j+1} (+δ)] / c_{j−1}"];
  g [label="Left region: solve 2×2 system\nψ_0, ψ_1 = A e^{ikx} + B e^{−ikx}"];
  h [label="T = 1/|A|²,   R = |B|²/|A|²"];
  i [label="Verify: R + T = 1 (flux),\nT vs analytic formula"];
  j [label="Error analysis: h = 0.1 … 0.0016,\nmisaligned / aligned / corrected"];
  t [label="END: T(E) curve + convergence plot", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  s->a->b->c->d->e; e->e1 [label="yes"]; e->e2 [label="no"]; e1->f; e2->f; f->d [label="next j", style=dashed];
  f->g [label="j = 1 done"]; g->h->i->j->t;
}
