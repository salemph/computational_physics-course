digraph G {
  graph [fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
  s [label="START: Z=1, l, h, R = 40 n", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  a [label="grid r_j = j h;  c_j = 1 + h²[2E + 2/r_j − l(l+1)/r_j²]/12"];
  b [label="Scan E on a log grid in [−0.6, −0.02]"];
  c [label="SHOOT(E):\n• Frobenius u = r^{l+1}Σa_k r^k  on nodes ≤ r_s+h\n• outward Numerov to the outer turning point m\n• inward Numerov from R (u_N=0, u_{N−1}=ε)\n• D(E) = u^L_{m+1}u^R_m − u^L_m u^R_{m+1}"];
  d [label="sign D changes ?", shape=diamond, fillcolor="#fff4dc", color="#eda100"];
  e [label="Bisection on D(E) (60 halvings)"];
  f [label="Glue at m, normalise ∫u²dr = 1 (Simpson)"];
  v [label="Verify: E = −1/2n², u vs r R_nl (Laguerre, Part A),\n⟨r⟩ = [3n²−l(l+1)]/2,  ⟨V⟩ = 2E, orthogonality"];
  x [label="Error analysis: naive vs Frobenius start, h-series,\nbox size R, Richardson"];
  t [label="END: tables + plots", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  s->a->b->c->d; d->e [label="yes"]; d->b [label="no: next E", style=dashed]; e->f->v->x->t;
}
