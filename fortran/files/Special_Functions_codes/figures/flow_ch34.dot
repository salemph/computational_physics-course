digraph G {
  graph [fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.3, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", arrowsize=0.7];
  s [label="START: well radius 1, index m (or l), N, r_s", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  a [label="cylindrical: u = √r R,  k² = 2E − (m² − ¼)/r²\nspherical:   u = r R,   k² = 2E − l(l+1)/r²"];
  b [label="exact energies from Part A zeros:\nE = j²_{m,s}/2  or  z²_{l,s}/2  → bracket ±15 %"];
  c [label="SHOOT(E): Frobenius values up to r_s+h,\nNumerov outward to r = 1  →  F(E) = u_N"];
  d [label="Bisection on sign F(E)  (64 halvings)"];
  f [label="Normalise ∫u²dr = 1"];
  v [label="Verify: E vs zeros (Part A), u vs J_m / j_l,\n⟨r²⟩ closed form, orthogonality"];
  x [label="Error analysis: start strategy, h⁴ law,\nround-off floor, Richardson"];
  t [label="END", shape=oval, fillcolor="#dff3ea", color="#1baf7a"];
  s->a->b->c->d->f->v->x->t; d->c [label="each midpoint", style=dashed];
}
